{
  "name": "solid-snake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A telecom fraud intelligence platform built from published research. This demo runs on synthetic data and is not connected to any operator. Not yet reviewed by telecom practitioners.",
  "scripts": {
    "seed": "tsx server/seed/build.ts",
    "map": "tsx scripts/build-map.ts",
    "data": "npm run seed && npm run map",
    "api": "tsx server/api/server.ts",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "d3-geo": "^3.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
