# Allow-list: the build context holds only what the image build reads. Everything else (git history, tests, docs,
# local runtime data, generated output, any .env file) never enters a layer.
*
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!shared
!scripts
!server
!web
!data/geo

# regenerated inside the build by `npm run data`
web/src/generated
**/node_modules
**/*.log
